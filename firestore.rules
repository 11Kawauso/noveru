rules_version = '2';

// noveru のデータを守るルール
// Firebase コンソール → Firestore Database →「ルール」タブに、このファイルの中身を全部貼り付けて「公開」を押してください。
//
// ・書いたり直したりできるのは、その本の持ち主だけ
// ・並べている本（displayed が true）だけは、ログインしていない人も読める
// ・本棚に入っている本は、持ち主しか読めない

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isDisplayed(uid, bookId) {
      return get(/databases/$(database)/documents/users/$(uid)/books/$(bookId)).data.displayed == true;
    }

    function validBook(d) {
      return d.title is string && d.title.size() <= 100
        && d.author is string && d.author.size() <= 60
        && d.vertical is bool
        && d.displayed is bool
        && d.displayOrder is number
        && (d.cover == null || (d.cover is string && d.cover.size() <= 300000))
        && (!('tags' in d) || (d.tags is list && d.tags.size() <= 10));
    }

    // ペンネーム・プロフィール・アイコン（誰でも見られる）
    match /users/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.penName is string
        && request.resource.data.penName.size() <= 40
        && (!('bio' in request.resource.data)
            || (request.resource.data.bio is string && request.resource.data.bio.size() <= 1000))
        && (!('icon' in request.resource.data) || request.resource.data.icon == null
            || (request.resource.data.icon is string && request.resource.data.icon.size() <= 150000));
    }

    // タイトル・作者・表紙など
    match /users/{uid}/books/{bookId} {
      allow read: if isOwner(uid) || resource.data.displayed == true;
      allow create, update: if isOwner(uid) && validBook(request.resource.data);
      allow delete: if isOwner(uid);
    }

    // 本文
    match /users/{uid}/texts/{bookId} {
      allow read: if isOwner(uid) || isDisplayed(uid, bookId);
      allow create, update: if isOwner(uid) && request.resource.data.body is string;
      allow delete: if isOwner(uid);
    }

    // その本へのいいね（1人1件。数は誰でも見られる）
    // いいねできるのはログインした人だけで、公開中の本（または自分の本）に限る
    match /users/{uid}/books/{bookId}/likes/{likerId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == likerId
        && (isOwner(uid) || isDisplayed(uid, bookId));
      allow delete: if request.auth != null && (request.auth.uid == likerId || isOwner(uid));
    }

    // 「探す」用の公開中の作品の一覧（誰でも読める。書けるのはその本の持ち主だけ）
    match /public/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.bookId
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.author is string && request.resource.data.author.size() <= 60
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 10
        && (request.resource.data.cover == null
            || (request.resource.data.cover is string && request.resource.data.cover.size() <= 100000));
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // 自分がいいねした本・閲覧履歴（本人だけ）
    match /users/{uid}/liked/{key} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/history/{key} {
      allow read, write: if isOwner(uid);
    }
  }
}
